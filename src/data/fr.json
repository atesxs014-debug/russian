{
 "code": "fr",
 "units": [
  {
   "id": "u1", "level": "baslangic", "title": "Fransızca Sesler", "subtitle": "Aksanlar, genizden sesler, okunmayan harfler",
   "lessons": [
    {
     "id": "u1l1", "kind": "letters", "title": "Aksanlar ve sessiz e", "subtitle": "é · è · -e · ç",
     "intro": "Fransızcada harfin üstündeki işaret okunuşu değiştirir. Önce bunları çözelim.",
     "letters": [
      { "id": "e1", "upper": "é", "lower": "", "name": "café", "sound": "kapalı e", "hint": "Dar, net bir 'e'.", "words": [ { "t": "café", "tr": "kahve", "read": "kafe" }, { "t": "été", "tr": "yaz", "read": "ete" } ] },
      { "id": "e2", "upper": "è", "lower": "ê", "name": "mère", "sound": "açık e", "hint": "Ağız biraz daha açık bir 'e'.", "words": [ { "t": "mère", "tr": "anne", "read": "mer" }, { "t": "fête", "tr": "bayram, parti", "read": "fet" } ] },
      { "id": "e0", "upper": "-e", "lower": "", "name": "porte", "sound": "okunmaz (sonda)", "hint": "Kelime sonundaki aksansız e okunmaz.", "words": [ { "t": "porte", "tr": "kapı", "read": "port" }, { "t": "belle", "tr": "güzel", "read": "bel" } ] },
      { "id": "cc", "upper": "ç", "lower": "", "name": "garçon", "sound": "s", "hint": "Çengelli c = 's'. Türkçe 'ç' değil!", "words": [ { "t": "français", "tr": "Fransızca", "read": "frõse" }, { "t": "garçon", "tr": "erkek çocuk", "read": "garsõ" } ] }
     ]
    },
    {
     "id": "u1l2", "kind": "letters", "title": "Ünlü grupları", "subtitle": "ou · u · oi · eau · ai",
     "intro": "Birden fazla harf tek bir ünlü sesi verir. En sık kullanılan beş grup.",
     "letters": [
      { "id": "ou", "upper": "ou", "lower": "", "name": "vous", "sound": "u", "hint": "ou = Türkçe 'u'.", "words": [ { "t": "vous", "tr": "siz", "read": "vu" }, { "t": "rouge", "tr": "kırmızı", "read": "ruj" } ] },
      { "id": "u", "upper": "u", "lower": "", "name": "tu", "sound": "ü", "hint": "Tek u = Türkçe 'ü'!", "words": [ { "t": "tu", "tr": "sen", "read": "tü" }, { "t": "rue", "tr": "sokak", "read": "rü" } ] },
      { "id": "oi", "upper": "oi", "lower": "", "name": "moi", "sound": "va", "hint": "oi = 'va'.", "words": [ { "t": "moi", "tr": "ben", "read": "mva" }, { "t": "trois", "tr": "üç", "read": "trva" } ] },
      { "id": "eau", "upper": "eau", "lower": "au", "name": "beau", "sound": "o", "hint": "eau ve au = 'o'.", "words": [ { "t": "eau", "tr": "su", "read": "o" }, { "t": "beau", "tr": "yakışıklı", "read": "bo" } ] },
      { "id": "ai", "upper": "ai", "lower": "", "name": "lait", "sound": "e", "hint": "ai = 'e'.", "words": [ { "t": "lait", "tr": "süt", "read": "le" }, { "t": "maison", "tr": "ev", "read": "mezõ" } ] }
     ]
    },
    {
     "id": "u1l3", "kind": "letters", "title": "Genizden sesler", "subtitle": "an · on · in · un",
     "intro": "Fransızcanın imzası: ünlü + n/m genizden okunur, n sesi tam çıkmaz.",
     "letters": [
      { "id": "an", "upper": "an", "lower": "en", "name": "enfant", "sound": "genizden a", "hint": "an/en: 'a' genizden, n söylenmez.", "words": [ { "t": "enfant", "tr": "çocuk", "read": "ãfã" }, { "t": "France", "tr": "Fransa", "read": "frãs" } ] },
      { "id": "on", "upper": "on", "lower": "", "name": "bonjour", "sound": "genizden o", "hint": "on: 'o' genizden.", "words": [ { "t": "bonjour", "tr": "merhaba", "read": "bõjur" }, { "t": "non", "tr": "hayır", "read": "nõ" } ] },
      { "id": "in", "upper": "in", "lower": "ain", "name": "vin", "sound": "genizden e", "hint": "in/ain: açık 'e' genizden.", "words": [ { "t": "vin", "tr": "şarap", "read": "vẽ" }, { "t": "pain", "tr": "ekmek", "read": "pẽ" } ] },
      { "id": "un", "upper": "un", "lower": "", "name": "lundi", "sound": "genizden ö", "hint": "un: 'ö' genizden (bugün çoğu kişi 'in' gibi okur).", "words": [ { "t": "un", "tr": "bir", "read": "œ̃" }, { "t": "lundi", "tr": "pazartesi", "read": "lœ̃di" } ] }
     ]
    },
    {
     "id": "u1l4", "kind": "letters", "title": "Ünsüzler", "subtitle": "ch · j · gn · qu · r · h",
     "intro": "Bazıları Türkçede var ama farklı yazılıyor; h ise hiç okunmuyor.",
     "letters": [
      { "id": "ch", "upper": "ch", "lower": "", "name": "chat", "sound": "ş", "hint": "ch = 'ş'.", "words": [ { "t": "chat", "tr": "kedi", "read": "şa" }, { "t": "chocolat", "tr": "çikolata", "read": "şokola" } ] },
      { "id": "j", "upper": "j", "lower": "ge", "name": "je", "sound": "j", "hint": "j ve e/i önündeki g = 'j' (jale).", "words": [ { "t": "je", "tr": "ben", "read": "jö" }, { "t": "rouge", "tr": "kırmızı", "read": "ruj" } ] },
      { "id": "gn", "upper": "gn", "lower": "", "name": "montagne", "sound": "ny", "hint": "gn = 'ny'.", "words": [ { "t": "montagne", "tr": "dağ", "read": "mõtany" }, { "t": "champagne", "tr": "şampanya", "read": "şãpany" } ] },
      { "id": "qu", "upper": "qu", "lower": "", "name": "quatre", "sound": "k", "hint": "qu = 'k' (u okunmaz).", "words": [ { "t": "qui", "tr": "kim", "read": "ki" }, { "t": "quatre", "tr": "dört", "read": "katr" } ] },
      { "id": "r", "upper": "r", "lower": "", "name": "Paris", "sound": "gırtlak r", "hint": "Gırtlaktan, gargara yapar gibi hafif bir 'ğ/r'.", "words": [ { "t": "Paris", "tr": "Paris", "read": "pari" }, { "t": "rire", "tr": "gülmek", "read": "rir" } ] },
      { "id": "h", "upper": "h", "lower": "", "name": "homme", "sound": "okunmaz", "hint": "Fransızcada h hiç okunmaz.", "words": [ { "t": "homme", "tr": "adam", "read": "om" }, { "t": "hôtel", "tr": "otel", "read": "otel" } ] }
     ]
    },
    {
     "id": "u1l5", "kind": "reading", "title": "Okuma kuralları", "subtitle": "Sessiz sonlar, liaison, -er, ill",
     "intro": "Fransızcayı okumayı zorlaştıran 4 kural — bunları bilince metinler çözülür.",
     "rules": [
      { "title": "Sondaki ünsüz okunmaz", "text": "Kelime sonundaki çoğu ünsüz (t, d, s, x, z) okunmaz.", "examples": [ { "t": "petit", "tr": "küçük", "read": "pöti" }, { "t": "Paris", "tr": "Paris", "read": "pari" } ] },
      { "title": "Liaison (bağlama)", "text": "Okunmayan son ünsüz, sonraki kelime ünlüyle başlıyorsa okunur ve bağlanır.", "examples": [ { "t": "les amis", "tr": "arkadaşlar", "read": "lezami" }, { "t": "vous avez", "tr": "sizde var", "read": "vuzave" } ] },
      { "title": "-er / -ez → é", "text": "Fiil sonundaki -er ve -ez 'e' okunur.", "examples": [ { "t": "parler", "tr": "konuşmak", "read": "parle" }, { "t": "nez", "tr": "burun", "read": "ne" } ] },
      { "title": "ill → y", "text": "Çoğu kelimede ill 'y' okunur.", "examples": [ { "t": "famille", "tr": "aile", "read": "famiy" }, { "t": "fille", "tr": "kız", "read": "fiy" } ] }
     ],
     "words": [
      { "t": "petit", "tr": "küçük", "read": "pöti" }, { "t": "les amis", "tr": "arkadaşlar", "read": "lezami" }, { "t": "parler", "tr": "konuşmak", "read": "parle" },
      { "t": "nez", "tr": "burun", "read": "ne" }, { "t": "famille", "tr": "aile", "read": "famiy" }, { "t": "fille", "tr": "kız", "read": "fiy" },
      { "t": "merci", "tr": "teşekkürler", "read": "mersi" }, { "t": "beaucoup", "tr": "çok", "read": "boku" }, { "t": "vous avez", "tr": "sizde var", "read": "vuzave" }, { "t": "grand", "tr": "büyük", "read": "grã" }
     ]
    }
   ]
  }
 ],
