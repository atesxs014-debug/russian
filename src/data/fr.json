  { "level": "yuksek", "title": "Subjonctif" }, { "level": "yuksek", "title": "Dolaylı anlatım" }, { "level": "yuksek", "title": "Metin okuma ve anlama" }, { "level": "yuksek", "title": "Serbest konuşma" }
 ],
 "quotes": [
  { "t": "Petit à petit, l'oiseau fait son nid.", "tr": "Kuş yuvasını azar azar yapar." },
  { "t": "Mieux vaut tard que jamais.", "tr": "Geç olsun da güç olmasın." },
  { "t": "Vouloir, c'est pouvoir.", "tr": "İstemek başarmaktır." },
  { "t": "C'est en forgeant qu'on devient forgeron.", "tr": "Demirci demir döverek olur." },
  { "t": "Après la pluie, le beau temps.", "tr": "Yağmurdan sonra güneş açar." },
  { "t": "L'habit ne fait pas le moine.", "tr": "Kıyafet insanı keşiş yapmaz." },
  { "t": "Qui ne risque rien n'a rien.", "tr": "Risk almayan bir şey kazanamaz." }
 ]
