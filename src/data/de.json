 "quotes": [
  { "t": "Übung macht den Meister.", "tr": "Pratik ustalaştırır." },
  { "t": "Aller Anfang ist schwer.", "tr": "Her başlangıç zordur." },
  { "t": "Ende gut, alles gut.", "tr": "Sonu iyi olan her şey iyidir." },
  { "t": "Morgenstund hat Gold im Mund.", "tr": "Erken kalkan yol alır." },
  { "t": "Wer rastet, der rostet.", "tr": "İşleyen demir ışıldar." },
  { "t": "Steter Tropfen höhlt den Stein.", "tr": "Damlaya damlaya göl olur." },
  { "t": "Lieber spät als nie.", "tr": "Geç olsun da güç olmasın." }
 ]
