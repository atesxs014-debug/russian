      { "id": "z", "upper": "z", "lower": "", "name": "pizza", "sound": "ts / dz", "hint": "z çoğunlukla 'ts' ya da 'dz' — Türkçe 'z' değil.", "words": [ { "t": "pizza", "tr": "pizza", "read": "pittsa" }, { "t": "zero", "tr": "sıfır", "read": "dzero" } ] },
      { "id": "h", "upper": "h", "lower": "", "name": "ho", "sound": "okunmaz", "hint": "h tek başına hiç okunmaz.", "words": [ { "t": "ho", "tr": "bende var", "read": "o" }, { "t": "hanno", "tr": "onlarda var", "read": "anno" } ] }
