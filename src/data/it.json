      { "id": "ca", "upper": "ca", "lower": "co · cu", "name": "casa", "sound": "k", "hint": "a, o, u önünde c = 'k'.", "words": [ { "t": "casa", "tr": "ev", "read": "kaza" }, { "t": "cuore", "tr": "kalp", "read": "kuore" } ] },
      { "id": "ci", "upper": "ci", "lower": "ce", "name": "ciao", "sound": "ç", "hint": "e, i önünde c = 'ç'.", "words": [ { "t": "ciao", "tr": "merhaba / hoşça kal", "read": "çao" }, { "t": "cena", "tr": "akşam yemeği", "read": "çena" } ] },
      { "id": "ga", "upper": "ga", "lower": "go · gu", "name": "gatto", "sound": "g", "hint": "a, o, u önünde g = 'g'.", "words": [ { "t": "gatto", "tr": "kedi", "read": "gatto" }, { "t": "gusto", "tr": "tat", "read": "gusto" } ] },
      { "id": "gi", "upper": "gi", "lower": "ge", "name": "gelato", "sound": "c", "hint": "e, i önünde g = Türkçe 'c'.", "words": [ { "t": "gelato", "tr": "dondurma", "read": "celato" }, { "t": "giorno", "tr": "gün", "read": "corno" } ] }
     ]
    },
    {
