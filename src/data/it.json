     "intro": "c/g'yi e ve i önünde sert okutmak için araya h girer. sc grupları da aynı kurala uyar.",
     "letters": [
      { "id": "chi", "upper": "chi", "lower": "che", "name": "chiesa", "sound": "k (h ile)", "hint": "ch = 'k' (h sertleştirir).", "words": [ { "t": "che", "tr": "ne", "read": "ke" }, { "t": "chiesa", "tr": "kilise", "read": "kieza" } ] },
      { "id": "ghi", "upper": "ghi", "lower": "ghe", "name": "spaghetti", "sound": "g (h ile)", "hint": "gh = 'g'.", "words": [ { "t": "spaghetti", "tr": "spagetti", "read": "spagetti" }, { "t": "ghiaccio", "tr": "buz", "read": "giaççio" } ] },
      { "id": "sci", "upper": "sci", "lower": "sce", "name": "pesce", "sound": "ş", "hint": "e, i önünde sc = 'ş'.", "words": [ { "t": "pesce", "tr": "balık", "read": "peşe" }, { "t": "scienza", "tr": "bilim", "read": "şientsa" } ] },
      { "id": "sca", "upper": "sca", "lower": "sco · scu", "name": "scuola", "sound": "sk", "hint": "a, o, u önünde sc = 'sk'.", "words": [ { "t": "scuola", "tr": "okul", "read": "skuola" }, { "t": "scarpa", "tr": "ayakkabı", "read": "skarpa" } ] }
     ]
    },
    {
