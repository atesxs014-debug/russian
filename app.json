{
  "expo": {
    "name": "Voxa",
    "slug": "voxa",
    "version": "0.5.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#6A48E8",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6A48E8"
    },
    "ios": {
      "bundleIdentifier": "com.voxa.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "Voxa",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.voxa.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6A48E8"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Voxa, telaffuzunu değerlendirmek için mikrofonu kullanır. Kayıtlar cihazından çıkmaz."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C8CFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı seçmek için galerine erişim gerekiyor.",
          "cameraPermission": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Voxa",
              "label": "Voxa",
              "description": "Seri, bekleyen tekrar ve günün kelimesi",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
