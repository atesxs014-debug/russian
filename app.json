{
  "expo": {
    "name": "Voxa",
    "slug": "voxa",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D1120",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1120"
    },
    "ios": {
      "bundleIdentifier": "com.voxa.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "Voxa",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.voxa.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1120"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Voxa, telaffuzunu değerlendirmek için mikrofonu kullanır. Kayıtlar cihazından çıkmaz."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C8CFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı seçmek için galerine erişim gerekiyor.",
          "cameraPermission": false
        }
      ]
    ]
  }
}
